#!r6rs ; -*- scheme -*-
(import (akku format manifest))

;; Both dependencies are for development only, so a project that depends on
;; chez-libuv installs neither: chez-srfi runs the test suites, and
;; chez-cmark-gfm renders docs/ into the docs site (`make site`).
;;
;; chez-srfi's version is exact, not a caret range. `akku lock` takes the
;; newest version a range allows, and the test suites use the chez-srfi
;; submodule, which `make check-pins` holds to the commit Akku.lock names.
;; Change the two together.
(akku-package ("chez-libuv" "0.10.0")
  (synopsis "Thin R6RS bindings to libuv asynchronous I/O for Chez Scheme")
  (authors "Kiyomi Computation Systems LLC")
  (license "BSD-3-Clause")
  (depends/dev ("chez-srfi" "0.0.0-akku.181.7879b52")
               ("chez-cmark-gfm" "^2.0.0")))
