#!/bin/sh
# check-akku: install this package with Akku the way consumers do, and check
# what they get: the libraries, a shim that loads, and the install hook's
# answer in each case where it must not simply build.
#
# Akku runs two kinds of scripts: the current project's own Akku.manifest
# scripts, and those of each Akku.lock entry, which `akku lock` copies only
# from the Akku index. So chez-libuv's hook reaches a consumer two ways, and
# both run scripts/akku-install:
#   - the index route: the lock entry carries Akku.manifest's (scripts ...);
#   - the consumer route: the consumer's own manifest runs the script by path.
#
# Every package is made from the files git tracks, copied from the working
# tree, so uncommitted edits to tracked files are what gets tested. Akku runs
# with its log at debug level, so the hook's own output is in each log under
# every Akku; with both prompts answered y on stdin, since Akku before 1.1.1
# has no --yes; and with MAKEFLAGS cleared, except where a row sets it.
# Akku before 1.1.1 ignores a script's exit status, so where a failing hook
# stops 1.1.1's install, an older Akku's install goes on and the failure
# shows at the program's first call instead. The rows expect whichever this
# Akku does.
#
# Rows:
#   1. index route, from an archive, under a parent make's MAKEFLAGS: one
#      hook run; exactly src/'s libraries plus config.sls; a program gets a
#      fired timer, libuv's version and a release shim in this consumer's
#      .akku/ffi;
#   2. reinstall: again, and then with a compiler that fails, which must
#      leave the working install in place, or (older Akku) name the failure;
#   3. no usable libuv on a fresh install: the stub config.sls raises the
#      reason, naming the hook's log; 3b. a second consumer of the same
#      directory replaces that stub;
#   4. chez-libuv's own checkout, entered through a symbolic link: the hook
#      does nothing;
#   5. a built checkout used as a directory source: left alone;
#   6. consumer route, through `akku lock`, with a compiler that warns: the
#      lock carries no scripts; build/ and vendor/ stay out of .akku/lib.
#
# Needs akku, chez, git, pkg-config with libuv, and a C compiler on PATH;
# AKKU and CHEZ override; CC, if set, is the compiler for the check's own
# setup and for the hook. CHECK_AKKU_KEEP=1 keeps the work directory.
set -eu

AKKU=${AKKU:-akku}
CHEZ=${CHEZ:-chez}
root=$(cd "$(dirname "$0")/.." && pwd -P)
work=$(mktemp -d "${TMPDIR:-/tmp}/check-akku.XXXXXX")
work=$(cd "$work" && pwd -P)
if [ -n "${CHECK_AKKU_KEEP:-}" ]; then
  echo "check-akku: keeping $work"
else
  trap 'rm -rf "$work"' EXIT
fi

fail() { echo "check-akku: FAIL: $*" >&2; exit 1; }
say() { echo "check-akku: $*"; }
# fail_log LOG MESSAGE: fail, showing the end of LOG, and the install hook's
# own log when LOG sits in a consumer that has one: Akku before 1.1.1 shows
# a script's output only at debug level, and the hook's reason is there.
fail_log() {
  tail -n 40 "$1" >&2 || true
  _hook_log=$(dirname "$1")/.akku/ffi/chez-libuv-install.log
  if [ -f "$_hook_log" ]; then
    echo "--- the install hook's log, $_hook_log:" >&2
    tail -n 20 "$_hook_log" >&2 || true
  fi
  fail "$2"
}

# The compiler the check's own setup uses (row 5's make build, row 6's
# wrapper), found the way the hook finds one: CC, else cc, gcc or clang.
# CC is not set for Akku's runs: the hook looks for itself.
if [ -n "${CC:-}" ]; then
  setup_cc=$CC
else
  setup_cc=
  for c in cc gcc clang; do
    if command -v "$c" > /dev/null 2>&1; then setup_cc=$c; break; fi
  done
fi
[ -n "$setup_cc" ] || fail "no C compiler: set CC, or put cc, gcc or clang on PATH"

# The rows need the libuv the hook needs: at the floor, where pkg-config sees it.
floor=$(cd "$root" && env -u MAKEFLAGS -u MFLAGS -u MAKELEVEL make -s akku-facts FLAVOR=prod |
          sed -n 's/^floor=//p')
[ -n "$floor" ] || fail "make akku-facts printed no libuv floor"
pkg-config --atleast-version="$floor" libuv ||
  fail "pkg-config finds no libuv $floor or newer (it finds $(pkg-config --modversion libuv 2> /dev/null || echo none)); every row needs one"

sha256() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1"; else shasum -a 256 "$1"; fi |
    cut -d ' ' -f 1
}

# Akku 1.1.1 stops an install whose script fails; earlier ones go on.
akku_version=$("$AKKU" version 2>/dev/null | tail -n 1)
case $akku_version in
  0.* | 1.0.* | 1.1.0) hook_failure=ignored ;;
  *) hook_failure=stops ;;
esac
say "akku $akku_version: a failing hook's install $( [ $hook_failure = stops ] && echo stops || echo goes on)"

# The package's name, version and (scripts ...) form, from Akku.manifest.
cat > "$work/manifest.ss" <<'EOF'
(with-input-from-file "Akku.manifest"
  (lambda ()
    (let loop ()
      (let ((d (read)))
        (cond ((eof-object? d) (error 'check-akku "no akku-package form"))
              ((and (pair? d) (eq? (car d) 'akku-package))
               (display (car (cadr d))) (newline)
               (display (cadr (cadr d))) (newline)
               (let ((s (assq 'scripts (cddr d))))
                 (when s (write s)))
               (newline))
              (else (loop)))))))
EOF
(cd "$root" && "$CHEZ" -q --script "$work/manifest.ss") > "$work/manifest.out" ||
  fail "could not read Akku.manifest"
package=$(sed -n 1p "$work/manifest.out")
version=$(sed -n 2p "$work/manifest.out")
scripts=$(sed -n 3p "$work/manifest.out")

# The tracked files. --no-recursion keeps a submodule's directory empty, as
# it is in an archive; GNU tar applies it only to names after it, so it
# comes before -T. Each step writes a file rather than feeding a pipe, so a
# failure in any of them stops the check.
(cd "$root" && git ls-files -z) > "$work/files" || fail "git ls-files failed"
(cd "$root" && tar --null --no-recursion -T "$work/files" -cf "$work/pkg.tar") ||
  fail "could not archive the tracked files"
mkdir "$work/clean"
tar -xf "$work/pkg.tar" -C "$work/clean" || fail "could not unpack the package"

# copy_package NAME: a fresh copy of the tracked files at $work/NAME.
copy_package() { cp -Rp "$work/clean" "$work/$1"; }

# An archive of the tracked files plus a library under build/ and one under
# vendor/, which a source tree can hold and no consumer may install. It is
# put in a private Akku cache under its sha256, so Akku extracts it with its
# own reader, which keeps no file modes, and downloads nothing.
copy_package archive
mkdir -p "$work/archive/build" "$work/archive/vendor/stray"
printf '#!r6rs\n(library (stray) (export stray) (import (rnrs)) (define stray 1))\n' \
  > "$work/archive/build/stray.sls"
printf '#!r6rs\n(library (stray stray) (export stray) (import (rnrs)) (define stray 2))\n' \
  > "$work/archive/vendor/stray/stray.sls"
# ustar, with no macOS metadata: Akku's tar reader decodes pax header values
# as UTF-8 and fails on the binary extended attributes macOS tar stores.
(cd "$work/archive" && COPYFILE_DISABLE=1 tar --format ustar -czf "$work/pkg.tar.gz" $(ls -A)) ||
  fail "could not make the archive"
archive_sha=$(sha256 "$work/pkg.tar.gz")
mkdir -p "$work/cache/akku"
cp "$work/pkg.tar.gz" "$work/cache/akku/$package-$archive_sha"
archive_location="(location (url \"https://invalid.example/$package.tar.gz\")) (content (sha256 \"$archive_sha\"))"

expected_version=$(pkg-config --modversion libuv) || fail "pkg-config finds no libuv"
mkdir "$work/no-pkgconfig"

# consumer NAME LOCATION SCRIPTS: a project at $work/NAME whose Akku.lock
# has this package at LOCATION, with SCRIPTS in its entry.
consumer() {
  mkdir "$work/$1"
  cat > "$work/$1/Akku.manifest" <<EOF
#!r6rs
(import (akku format manifest))
(akku-package ("check-akku-consumer" "0.0.0")
  (synopsis "check-akku's consumer") (authors "check-akku") (license "MIT")
  (depends ("$package" "^$version")))
EOF
  cat > "$work/$1/Akku.lock" <<EOF
#!r6rs
(import (akku format lockfile))
(projects ((name "$package") $2 $3))
EOF
}

# run_akku DIR LOG "NAME=VALUE ..." ARGS...: Akku in DIR with ARGS, both
# prompts answered y, its output in LOG. The third argument's assignments
# (values without spaces) are added to the environment.
run_akku() {
  _dir=$1 _log=$2 _env=$3
  shift 3
  # shellcheck disable=SC2086
  (cd "$_dir" && printf 'y\ny\n' |
     env -u MAKEFLAGS -u MFLAGS -u MAKELEVEL AKKU_LOG_LEVEL=debug \
       XDG_CACHE_HOME="$work/cache" $_env "$AKKU" "$@") > "$_log" 2>&1
}

# The libraries this package installed into DIR/.akku/lib, one per line.
# Akku installs a library that imports (chezscheme) as NAME.chezscheme.sls,
# so that suffix is folded back to .sls. A library whose name has one part,
# (libuv), is installed twice, as libuv.sls and as libuv/main.sls; the
# second counts only as a byte-for-byte copy of the first.
installed_libraries() {
  awk -F '\t' -v p="$package" '$2 == p && $3 == "r6rs-library" { sub("^\\.akku/lib/", "", $1); print $1 }' \
    "$1/.akku/list" | sed 's/\.chezscheme\.sls$/.sls/' | sort > "$1/installed.all"
  while read -r f; do
    case $f in
      */main.sls)
        twin=${f%/main.sls}.sls
        if grep -qxF "$twin" "$1/installed.all" &&
           cmp -s "$1/.akku/lib/$f" "$1/.akku/lib/$twin"; then
          continue
        fi ;;
    esac
    echo "$f"
  done < "$1/installed.all"
}
(cd "$root" && git ls-files -- 'src/*.sls' | sed 's#^src/##'; echo libuv/private/config.sls) |
  sort > "$work/expected.txt"
[ "$(wc -l < "$work/expected.txt")" -gt 1 ] || fail "git tracks no src/*.sls; nothing to compare against"

# check_libraries ROW DIR: exactly src/'s libraries and config.sls.
check_libraries() {
  installed_libraries "$2" > "$2/installed.txt"
  diff -u "$work/expected.txt" "$2/installed.txt" > "$2/libraries.diff" ||
    { cat "$2/libraries.diff" >&2
      fail "$1: the installed libraries are not exactly src/'s plus config.sls (- missing, + extra)"; }
}

# A program that needs a loaded shim for every line it prints: a timer's
# callback, libuv's own version string, which entries the shim has, and the
# shim's path.
cat > "$work/program.sps" <<'EOF'
(import (rnrs) (libuv)
        (only (libuv private native) shim-file)
        (only (chezscheme) foreign-entry?))
(define fired 'never-fired)
(define loop (make-uv-loop))
(define timer (make-uv-timer loop))
(uv-timer-start! timer (lambda (t) (set! fired 'fired) (uv-close! t)) 0 0)
(uv-run loop 'default)
(uv-loop-teardown! loop)
(display (uv-version)) (newline)
(display fired) (newline)
(display (if (foreign-entry? "chez_uv_constant") 'has-constant 'no-constant)) (newline)
(display (if (foreign-entry? "chez_uv_debug_pool_hold") 'dev-shim 'release-shim)) (newline)
(display (shim-file)) (newline)
EOF

# run_program LIBDIR OUT: the program on LIBDIR alone; its status.
run_program() {
  env -u CHEZ_LIBUV_SHIM CHEZSCHEMELIBDIRS="$1" "$CHEZ" --program "$work/program.sps" > "$2" 2>&1
}

# check_program ROW DIR: the program, on DIR's .akku/lib, works.
check_program() {
  run_program "$2/.akku/lib" "$2/program.out" ||
    fail_log "$2/program.out" "$1: the program failed on the installed libraries"
  [ "$(sed -n 1p "$2/program.out")" = "$expected_version" ] ||
    fail_log "$2/program.out" "$1: uv-version is not libuv $expected_version, the version pkg-config reports"
  [ "$(sed -n 2p "$2/program.out")" = fired ] ||
    fail_log "$2/program.out" "$1: the timer's callback did not fire"
  [ "$(sed -n 3p "$2/program.out")" = has-constant ] ||
    fail_log "$2/program.out" "$1: the loaded shim has no chez_uv_constant (the release-shim control)"
  [ "$(sed -n 4p "$2/program.out")" = release-shim ] ||
    fail_log "$2/program.out" "$1: the installed shim is a dev build (it exports the pool hold)"
  case $(sed -n 5p "$2/program.out") in
    "$2/.akku/ffi/"*) ;;
    *) fail_log "$2/program.out" "$1: the loaded shim is not in this consumer's .akku/ffi" ;;
  esac
}

# check_raises ROW LIBDIR OUT REASON LOG: the program's first call raises
# the hook's failure, naming REASON and the hook's LOG.
check_raises() {
  if run_program "$2" "$3"; then
    fail_log "$3" "$1: the program ran; expected the hook's failure to be raised"
  fi
  grep -qF "Exception in chez-libuv: $4" "$3" ||
    fail_log "$3" "$1: the program did not raise the hook's reason ($4)"
  grep -qF "$5" "$3" ||
    fail_log "$3" "$1: the raised message does not name the hook's log ($5)"
}

no_libuv="PKG_CONFIG_LIBDIR=$work/no-pkgconfig PKG_CONFIG_PATH="
no_libuv_reason="pkg-config finds no libuv"

# --- 1. the index route -------------------------------------------------
row="row 1 (index route, archive, a parent make's MAKEFLAGS)"
say "$row"
consumer c1 "$archive_location" "$scripts"
run_akku "$work/c1" "$work/c1/install.log" "MAKEFLAGS=HAVE_PKG=no FLAVOR=bogus" install ||
  fail_log "$work/c1/install.log" "$row: akku install failed"
runs=$(grep -c 'Running ".*akku-install' "$work/c1/install.log" || true)
[ "$runs" = 1 ] || fail_log "$work/c1/install.log" "$row: the hook ran $runs times, not once"
grep -qF "chez-libuv: built $work/c1/.akku/ffi/libchezlibuv." "$work/c1/install.log" ||
  fail_log "$work/c1/install.log" "$row: the hook did not say it built the shim into .akku/ffi"
check_libraries "$row" "$work/c1"
check_program "$row" "$work/c1"
# Each name on its own: an unmatched glob stays literal, and does not exist.
for left in "$work/c1/.akku/ffi/".chez-libuv-build.* "$work/c1/.akku/ffi/".libchezlibuv.*; do
  [ ! -e "$left" ] || fail "$row: the hook left $left in .akku/ffi"
done

# --- 2. reinstall -------------------------------------------------------
row="row 2 (reinstall)"
say "$row"
run_akku "$work/c1" "$work/c1/reinstall.log" "" install ||
  fail_log "$work/c1/reinstall.log" "$row: akku install failed the second time"
check_program "$row" "$work/c1"
# A compiler that fails, so the hook gets as far as building before it
# fails, past every check that could stop it sooner.
row="row 2 (reinstall with a compiler that fails)"
say "$row"
printf '#!/bin/sh\necho "check-akku: this compiler fails" >&2\nexit 1\n' > "$work/cc-fail"
chmod +x "$work/cc-fail"
compile_reason="compiling the shim failed"
if [ $hook_failure = stops ]; then
  if run_akku "$work/c1" "$work/c1/reinstall-fail.log" "CC=$work/cc-fail" install; then
    fail_log "$work/c1/reinstall-fail.log" "$row: akku install succeeded; the hook should have stopped it"
  fi
  grep -qF "$compile_reason" "$work/c1/reinstall-fail.log" ||
    fail_log "$work/c1/reinstall-fail.log" "$row: akku's output does not give the hook's reason"
  check_program "$row: the previous install" "$work/c1"
else
  run_akku "$work/c1" "$work/c1/reinstall-fail.log" "CC=$work/cc-fail" install ||
    fail_log "$work/c1/reinstall-fail.log" "$row: akku install failed"
  check_raises "$row" "$work/c1/.akku/lib" "$work/c1/reinstall-fail.out" \
    "$compile_reason" "$work/c1/.akku/ffi/chez-libuv-install.log"
fi

# --- 3. no usable libuv, fresh ------------------------------------------
row="row 3 (no libuv visible, fresh install)"
say "$row"
copy_package d3
consumer c3 "(location (directory \"$work/d3\"))" "$scripts"
if run_akku "$work/c3" "$work/c3/install.log" "$no_libuv" install; then
  [ $hook_failure = ignored ] ||
    fail_log "$work/c3/install.log" "$row: akku install succeeded; the hook should have stopped it"
  check_raises "$row" "$work/c3/.akku/lib" "$work/c3/program.out" \
    "$no_libuv_reason" "$work/c3/.akku/ffi/chez-libuv-install.log"
else
  [ $hook_failure = stops ] || fail_log "$work/c3/install.log" "$row: akku install failed"
  grep -qF "$no_libuv_reason" "$work/c3/install.log" ||
    fail_log "$work/c3/install.log" "$row: akku's output does not give the hook's reason"
fi
check_raises "$row: the source's own config.sls" "$work/d3/src" "$work/c3/source-program.out" \
  "$no_libuv_reason" "$work/c3/.akku/ffi/chez-libuv-install.log"
# Another consumer of the same directory, with libuv visible: the first
# one's stub is the hook's own, so it is replaced, not refused.
row="row 3b (a second consumer of the same directory)"
say "$row"
consumer c3b "(location (directory \"$work/d3\"))" "$scripts"
run_akku "$work/c3b" "$work/c3b/install.log" "" install ||
  fail_log "$work/c3b/install.log" "$row: akku install failed"
check_program "$row" "$work/c3b"
# The build's own files went elsewhere: the directory holds only what it
# held, and config.sls.
[ ! -e "$work/d3/build" ] || fail "$row: the hook wrote a build/ directory into the source"

# --- 4. chez-libuv's own checkout ---------------------------------------
row="row 4 (akku install in chez-libuv's own checkout)"
say "$row"
copy_package d4
printf '#!r6rs\n(import (akku format lockfile))\n(projects)\n' > "$work/d4/Akku.lock"
# Entered through a symbolic link, as a checkout under macOS's /tmp or
# $TMPDIR is: Akku's paths are physical, and so must the hook's be.
ln -s "$work/d4" "$work/d4-link"
run_akku "$work/d4-link" "$work/d4/install.log" "" install ||
  fail_log "$work/d4/install.log" "$row: akku install failed"
grep -qF "chez-libuv: this is chez-libuv's own checkout" "$work/d4/install.log" ||
  fail_log "$work/d4/install.log" "$row: the hook did not say it skipped chez-libuv's own checkout"
[ ! -e "$work/d4/src/libuv/private/config.sls" ] ||
  fail "$row: the hook wrote src/libuv/private/config.sls into the checkout"
! ls "$work/d4/.akku/ffi/"libchezlibuv.* > /dev/null 2>&1 ||
  fail "$row: the hook built a shim for the checkout's own akku install"

# --- 5. a built checkout as a directory source --------------------------
row="row 5 (a built checkout as a directory source)"
say "$row"
copy_package d5
(cd "$work/d5" && env -u MAKEFLAGS -u MFLAGS -u MAKELEVEL make build CHEZ="$CHEZ" CC="$setup_cc") \
  > "$work/d5-build.log" 2>&1 || fail_log "$work/d5-build.log" "$row: make build failed in the copy"
cp "$work/d5/src/libuv/private/config.sls" "$work/d5-config.before"
consumer c5 "(location (directory \"$work/d5\"))" "$scripts"
if run_akku "$work/c5" "$work/c5/install.log" "" install; then
  [ $hook_failure = ignored ] ||
    fail_log "$work/c5/install.log" "$row: akku install succeeded; the hook should have refused"
else
  [ $hook_failure = stops ] || fail_log "$work/c5/install.log" "$row: akku install failed"
fi
grep -qF "chez-libuv: $work/d5 is a make build" "$work/c5/install.log" ||
  fail_log "$work/c5/install.log" "$row: the hook did not refuse the built checkout"
cmp -s "$work/d5-config.before" "$work/d5/src/libuv/private/config.sls" ||
  fail "$row: the built checkout's config.sls changed"

# --- 6. the consumer route ----------------------------------------------
row="row 6 (consumer route through akku lock, a compiler that warns)"
say "$row"
printf '#warning "check-akku-compiler-warning"\n' > "$work/warn.h"
printf '#!/bin/sh\nexec %s -include %s "$@"\n' "$setup_cc" "$work/warn.h" > "$work/cc-warn"
chmod +x "$work/cc-warn"
mkdir "$work/c6"
cat > "$work/c6/Akku.manifest" <<EOF
#!r6rs
(import (akku format manifest))
(akku-package ("check-akku-consumer" "0.0.0")
  (synopsis "check-akku's consumer") (authors "check-akku") (license "MIT")
  (depends ("$package" (version "$version") $archive_location))
  (scripts
    (cond-expand
      ((and pre-install (or darwin linux))
       (run "sh .akku/src/$package/scripts/akku-install")))))
EOF
run_akku "$work/c6" "$work/c6/lock.log" "" lock || fail_log "$work/c6/lock.log" "$row: akku lock failed"
! grep -q scripts "$work/c6/Akku.lock" ||
  fail "$row: akku lock copied scripts into the lock; the consumer route's premise is gone"
run_akku "$work/c6" "$work/c6/install.log" "CC=$work/cc-warn" install || true
# The compiler's diagnostics are in the hook's own log, whether it built or
# not. clang and gcc both put "warning:" or "error:" before the text.
hook_log=$work/c6/.akku/ffi/chez-libuv-install.log
[ -f "$hook_log" ] || fail_log "$work/c6/install.log" "$row: the hook wrote no log in .akku/ffi"
grep 'check-akku-compiler-warning' "$hook_log" > "$work/c6/diagnostics" || true
! grep -q 'error:' "$work/c6/diagnostics" ||
  fail_log "$hook_log" "$row: the compiler's warning failed the hook's build (-Werror)"
grep -q 'warning:' "$work/c6/diagnostics" ||
  fail_log "$hook_log" "$row: the hook's build did not show the compiler's warning"
grep -qF "chez-libuv: built $work/c6/.akku/ffi/libchezlibuv." "$work/c6/install.log" ||
  fail_log "$work/c6/install.log" "$row: the hook did not say it built the shim into .akku/ffi"
check_libraries "$row" "$work/c6"
check_program "$row" "$work/c6"

# --- 7. failures the hook names before it builds -----------------------
# expect_failure ROW CONSUMER ENV REASON: an install whose hook fails with
# REASON, seen as this Akku shows it: in akku's output when the failure
# stops the install, at the program's first call when it does not.
expect_failure() {
  _c=$2
  if run_akku "$_c" "$_c/install.log" "$3" install; then
    [ $hook_failure = ignored ] ||
      fail_log "$_c/install.log" "$1: akku install succeeded; the hook should have stopped it"
    check_raises "$1" "$_c/.akku/lib" "$_c/program.out" "$4" "$_c/.akku/ffi/chez-libuv-install.log"
  else
    [ $hook_failure = stops ] || fail_log "$_c/install.log" "$1: akku install failed"
    # Akku logs each line of a script's output as a Scheme string, written:
    # \ and " escaped.
    _written=$(printf '%s' "$4" | sed 's/\\/\\\\/g; s/"/\\"/g')
    grep -qF "$_written" "$_c/install.log" ||
      fail_log "$_c/install.log" "$1: akku's output does not give the hook's reason ($4)"
  fi
}

# A path make cannot take. The double quote also has to survive into the
# stub's Scheme string, so the message names the log exactly.
row="row 7 (a project path with a space and a double quote)"
say "$row"
copy_package d7
odd='c7 "odd"'
consumer "$odd" "(location (directory \"$work/d7\"))" "$scripts"
expect_failure "$row" "$work/$odd" "" \
  "the path $work/$odd/.akku/ffi holds a character make cannot take"
check_raises "$row: the source's own config.sls" "$work/d7/src" "$work/d7-program.out" \
  "the path $work/$odd/.akku/ffi holds a character make cannot take" \
  "$work/$odd/.akku/ffi/chez-libuv-install.log"

row="row 7 (no C compiler)"
say "$row"
copy_package d7b
consumer c7b "(location (directory \"$work/d7b\"))" "$scripts"
expect_failure "$row" "$work/c7b" "CC=$work/no-such-compiler" "no C compiler"

# A source the hook cannot write: no stub either, so it says so and stops,
# and an Akku that goes on installs no config.sls at all.
row="row 7 (a source directory the hook cannot write)"
say "$row"
copy_package d7c
chmod a-w "$work/d7c/src/libuv/private"
consumer c7c "(location (directory \"$work/d7c\"))" "$scripts"
if run_akku "$work/c7c" "$work/c7c/install.log" "" install; then
  [ $hook_failure = ignored ] ||
    fail_log "$work/c7c/install.log" "$row: akku install succeeded; the hook should have stopped it"
else
  [ $hook_failure = stops ] || fail_log "$work/c7c/install.log" "$row: akku install failed"
fi
chmod u+w "$work/d7c/src/libuv/private"
grep -qF "chez-libuv: cannot write into $work/d7c/src/libuv/private" "$work/c7c/install.log" ||
  fail_log "$work/c7c/install.log" "$row: the hook did not say it cannot write into the source"
[ ! -e "$work/d7c/src/libuv/private/config.sls" ] ||
  fail "$row: a config.sls appeared in the unwritable source"

say "$package $version: $(wc -l < "$work/c1/installed.txt" | tr -d ' ') libraries, a release shim in .akku/ffi, by both routes; each refusal held"
